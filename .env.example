# Copy to .env and fill in values. Never commit .env.

# Public hostname only (no https://)
N8N_HOST=nodejs-XXXXXX-XXXXXXX.cloudwaysnodeapps.com
N8N_PROTOCOL=https
N8N_PORT=3000
N8N_LISTEN_ADDRESS=127.0.0.1

# Must match your public URL (trailing slash)
N8N_WEBHOOK_URL=https://nodejs-XXXXXX-XXXXXXX.cloudwaysnodeapps.com/

# Required behind Cloudways / nginx reverse proxy
N8N_PROXY_HOPS=1

# Generate once and keep forever: openssl rand -hex 32
# Changing this later makes saved credentials unreadable.
N8N_ENCRYPTION_KEY=

GENERIC_TIMEZONE=UTC
TZ=UTC

N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168

# Keep under plan RAM (Cloudways Starter ~2GB)
NODE_OPTIONS=--max-old-space-size=768
